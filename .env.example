# Supabase — from your project's Settings > API page.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER prefix with NEXT_PUBLIC_. NEVER commit the real value.
# Only read from lib/providers, lib/supabase/service-role.ts, or app/api/*.
SUPABASE_SERVICE_ROLE_KEY=

# Stat provider selection (see AGENTS.md lib/providers/index.ts factory).
STAT_PROVIDER=espn

# ESPN private-league auth cookies (required if the league is private).
# Extract from browser devtools while logged into fantasy.espn.com.
ESPN_LEAGUE_ID=771894515
ESPN_SWID=
ESPN_S2=
